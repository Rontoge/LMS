
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>Order Confirmation</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #f1f5f9;
            font-family: Arial, Helvetica, sans-serif;
            color: #1e293b;
        }

        table {
            border-spacing: 0;
            border-collapse: collapse;
        }

        .email-wrapper {
            width: 100%;
            background-color: #f1f5f9;
            padding: 40px 12px;
        }

        .email-container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 35px rgba(15, 23, 42, 0.08);
        }

        .header {
            background-color: #4f46e5;
            background-image: linear-gradient(135deg, #4f46e5, #7c3aed);
            padding: 36px 28px;
            text-align: center;
            color: #ffffff;
        }

        .brand {
            font-size: 13px;
            font-weight: bold;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #e0e7ff;
            margin-bottom: 22px;
        }

        .success-icon {
            width: 58px;
            height: 58px;
            line-height: 58px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.18);
            border: 1px solid rgba(255, 255, 255, 0.35);
            font-size: 28px;
        }

        .header h1 {
            margin: 0 0 12px;
            font-size: 28px;
            line-height: 1.3;
        }

        .header p {
            margin: 0;
            font-size: 15px;
            line-height: 1.7;
            color: #e0e7ff;
        }

        .content {
            padding: 34px 30px;
        }

        .greeting {
            margin: 0 0 12px;
            font-size: 20px;
            color: #0f172a;
        }

        .description {
            margin: 0 0 28px;
            font-size: 14px;
            line-height: 1.8;
            color: #64748b;
        }

        .section-title {
            margin: 0 0 16px;
            font-size: 16px;
            color: #0f172a;
        }

        .order-card {
            width: 100%;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
        }

        .order-card td {
            padding: 16px;
        }

        .course-label {
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 8px;
        }

        .course-name {
            font-size: 16px;
            line-height: 1.5;
            font-weight: bold;
            color: #0f172a;
            overflow-wrap: anywhere;
        }

        .price {
            font-size: 18px;
            font-weight: bold;
            color: #4f46e5;
            white-space: nowrap;
        }

        .details {
            width: 100%;
            margin-top: 20px;
        }

        .details td {
            padding: 13px 0;
            border-bottom: 1px solid #f1f5f9;
            font-size: 13px;
        }

        .detail-label {
            color: #64748b;
        }

        .detail-value {
            text-align: right;
            font-weight: 600;
            color: #334155;
            overflow-wrap: anywhere;
        }

        .subtotal-row td {
            padding-top: 18px;
        }

        .total-row td {
            padding-top: 18px;
            border-bottom: none;
        }

        .total-label {
            font-size: 16px;
            font-weight: bold;
            color: #0f172a;
        }

        .total-value {
            font-size: 22px;
            font-weight: bold;
            color: #4f46e5;
            text-align: right;
        }

        .notice {
            margin-top: 26px;
            background-color: #eef2ff;
            border: 1px solid #e0e7ff;
            border-radius: 10px;
        }

        .notice td {
            padding: 18px;
        }

        .notice-title {
            margin: 0 0 6px;
            font-size: 14px;
            color: #3730a3;
        }

        .notice p {
            margin: 0;
            font-size: 13px;
            line-height: 1.7;
            color: #4338ca;
        }

        .footer {
            padding: 24px 28px;
            text-align: center;
            background-color: #f8fafc;
            border-top: 1px solid #e2e8f0;
        }

        .footer p {
            margin: 5px 0;
            font-size: 12px;
            line-height: 1.7;
            color: #64748b;
        }

        .footer strong {
            color: #334155;
        }

        @media only screen and (max-width: 480px) {
            .email-wrapper {
                padding: 16px 8px;
            }

            .header {
                padding: 28px 18px;
            }

            .header h1 {
                font-size: 24px;
            }

            .content {
                padding: 26px 18px;
            }

            .order-card td {
                padding: 12px;
            }

            .course-name {
                font-size: 14px;
            }

            .price {
                font-size: 15px;
            }
        }
    </style>
</head>

<body>
    <table role="presentation" width="100%" class="email-wrapper">
        <tr>
            <td align="center">

                <table role="presentation" class="email-container" width="600">

                    <!-- Header -->
                    <tr>
                        <td class="header">
                            <div class="brand">Your Learning Platform</div>

                            <div class="success-icon">&#10003;</div>

                            <h1>Order Confirmed!</h1>

                            <p>
                                Your purchase was successful.
                                Get ready to continue your learning journey.
                            </p>
                        </td>
                    </tr>

                    <!-- Main Content -->
                    <tr>
                        <td class="content">

                            <h2 class="greeting">
                                Thank you for your purchase!
                            </h2>

                            <p class="description">
                                We're excited to have you learning with us.
                                Your order details are included below for your records.
                            </p>

                            <h3 class="section-title">Order Summary</h3>

                            <!-- Course -->
                            <table role="presentation" class="order-card" width="100%">
                                <tr>
                                    <td>
                                        <div class="course-label">Course purchased</div>

                                        <div class="course-name">
                                            <%= order.name || "Online Course" %>
                                        </div>
                                    </td>

                                    <td align="right" valign="middle">
                                        <div class="price">
                                            <%= order.currency || "R" %>
                                            <%= Number(order.price || 0).toFixed(2) %>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Order Details -->
                            <table role="presentation" class="details" width="100%">

                                <tr>
                                    <td class="detail-label">Order number</td>
                                    <td class="detail-value">
                                        #<%= order._id %>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="detail-label">Order date</td>
                                    <td class="detail-value">
                                        <%= order.date %>
                                    </td>
                                </tr>

                                <tr class="subtotal-row">
                                    <td class="detail-label">Subtotal</td>
                                    <td class="detail-value">
                                        <%= order.currency || "R" %>
                                        <%= Number(order.subtotal ?? order.price ?? 0).toFixed(2) %>
                                    </td>
                                </tr>

                                <% if (Number(order.discount || 0) > 0) { %>
                                    <tr>
                                        <td class="detail-label">Discount</td>
                                        <td class="detail-value">
                                            -<%= order.currency || "R" %>
                                            <%= Number(order.discount).toFixed(2) %>
                                        </td>
                                    </tr>
                                <% } %>

                                <% if (Number(order.tax || 0) > 0) { %>
                                    <tr>
                                        <td class="detail-label">Tax</td>
                                        <td class="detail-value">
                                            <%= order.currency || "R" %>
                                            <%= Number(order.tax).toFixed(2) %>
                                        </td>
                                    </tr>
                                <% } %>

                                <tr class="total-row">
                                    <td class="total-label">Total</td>
                                    <td class="total-value">
                                        <%= order.currency || "R" %>
                                        <%= Number(order.total ?? order.price ?? 0).toFixed(2) %>
                                    </td>
                                </tr>

                            </table>

                            <!-- Notice -->
                            <table role="presentation" class="notice" width="100%">
                                <tr>
                                    <td>
                                        <h3 class="notice-title">
                                            Ready to start learning?
                                        </h3>

                                        <p>
                                            Your course purchase has been recorded.
                                            Visit your learning dashboard to access
                                            your course and continue your studies.
                                        </p>
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td class="footer">
                            <p><strong>Your Learning Platform</strong></p>

                            <p>
                                Thank you for choosing us for your learning journey.
                            </p>

                            <p>
                                This is an automated order confirmation email.
                                Please do not reply directly to this message.
                            </p>

                            <p>
                                &copy; <%= new Date().getFullYear() %>
                                Your Learning Platform. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</body>
</html>
